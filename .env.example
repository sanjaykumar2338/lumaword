APP_NAME=Luma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumaword
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@lumaword.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VAPID_SUBJECT=mailto:notifications@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONNECT_TIMEOUT=10
OPENAI_TIMEOUT=120

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI="${APP_URL}/api/v1/youtube/callback"
YOUTUBE_CONNECT_TIMEOUT=5
YOUTUBE_TIMEOUT=20
YOUTUBE_REQUESTS_PER_MINUTE=10

SERMON_MIN_TRANSCRIPT_CHARACTERS=200
SERMON_MAX_TRANSCRIPT_CHARACTERS=120000
SERMON_MAX_UPLOAD_KB=25600
SERMON_MAX_DURATION_SECONDS=7200
SERMON_DAILY_PROCESSING_LIMIT=10
SERMON_JOB_TIMEOUT=180
SERMON_PROCESSING_LOCK_SECONDS=240
SERMON_PROCESSING_STALE_AFTER_SECONDS=1800
SERMON_PROMPT_VERSION=sermon-notes-v1
SERMON_MAX_OUTPUT_TOKENS=6000
SERMON_QA_MAX_QUESTION_CHARACTERS=2000
SERMON_QA_DAILY_QUESTIONS=20
SERMON_QA_RECENT_MESSAGES=8
SERMON_QA_MAX_OUTPUT_TOKENS=1200
SERMON_QA_MAX_CONTEXT_CHARACTERS=12000
SERMON_QA_MAX_CONTEXT_CHUNKS=6
SERMON_QA_CONTEXT_CHUNK_CHARACTERS=1800
SERMON_QA_SOURCE_EXCERPT_CHARACTERS=500
SERMON_QA_MESSAGES_PER_PAGE=20
SERMON_QA_TIMEOUT=45
SERMON_QA_LOCK_SECONDS=60
